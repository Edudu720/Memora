<?xml version="1.0" encoding="utf-8"?>
<!--
    Mesma regra de data_extraction_rules.xml, para o Android 11 ou anterior
    (D3 da 003, FR-042c da 004). Com `allowBackup="false"` o sistema ja nao
    copia nada; este arquivo e o cinto de seguranca para aparelhos que
    ignorem a bandeira.
-->
<full-backup-content>
    <exclude domain="root" path="."/>
    <exclude domain="file" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="external" path="."/>
</full-backup-content>
