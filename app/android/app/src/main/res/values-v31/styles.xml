<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 ou mais novo, modo claro (feature 013, T038; FR-037, R9).
         O sistema desenha a abertura sozinho, e ignora o `windowBackground`:
         o fundo vem de `windowSplashScreenBackground` e a Memora do
         `windowSplashScreenAnimatedIcon` (o desenho parado, de 288 dp, com a
         Memora de 160 dp no centro). O mesmo fundo e o mesmo lugar do aceno
         que vem em seguida. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/abertura_fundo</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/memora_abertura_icone</item>
    </style>
</resources>
